{
  "name": "xquang-production-templates",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render:intro": "remotion render src/index.ts IntroOutro out/intro.mp4",
    "render:lower-third": "remotion render src/index.ts LowerThird out/lower-third.mp4",
    "render:case-study": "remotion render src/index.ts CaseStudy out/case-study.mp4",
    "render:batch": "node scripts/batch-render.mjs",
    "render:real-estate-location": "remotion render src/index.ts RealEstateLocation out/real-estate-location.mp4 --gl=angle --concurrency=1",
    "render:footage-lower-third": "remotion render src/index.ts FootageLowerThird out/footage-lower-third.mp4",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.520",
    "@remotion/cli": "4.0.520",
    "@remotion/google-fonts": "4.0.520",
    "@remotion/media-utils": "4.0.520",
    "@remotion/renderer": "4.0.520",
    "@turf/turf": "^7.4.0",
    "maplibre-gl": "^6.11.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.520",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.8.3"
  }
}
